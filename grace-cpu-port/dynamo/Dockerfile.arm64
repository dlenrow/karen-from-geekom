# Dynamo FULL STACK ARM64 container for BF-3 SH (self-hosted)
# BF-3 ARM cores are the host CPU for GPU on PCIe root complex
# Builds: control plane + inference workers + CUDA + SGLang
#
# Build: docker buildx build --platform linux/arm64 -t dynamo-bf3sh:arm64 -f Dockerfile.arm64 .
# Or native on BF-3: docker build -t dynamo-bf3sh:arm64 -f Dockerfile.arm64 .

FROM nvcr.io/nvidia/cuda:12.8.0-devel-ubuntu24.04 AS builder

ARG DYNAMO_BRANCH=main

ENV DEBIAN_FRONTEND=noninteractive

# System deps + Rust
RUN apt-get update && apt-get install -y \
    build-essential cmake pkg-config \
    protobuf-compiler libprotobuf-dev \
    libhwloc-dev libudev-dev libssl-dev \
    libzmq3-dev python3-dev python3-pip python3-venv \
    git curl wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

RUN pip3 install --no-cache-dir --break-system-packages \
    maturin patchelf setuptools wheel meson-python

# Build Dynamo
WORKDIR /opt
RUN git clone --branch ${DYNAMO_BRANCH} --depth 1 https://github.com/ai-dynamo/dynamo.git
WORKDIR /opt/dynamo
RUN cargo build --release 2>&1 || true

# Python package
RUN pip3 install --no-cache-dir --break-system-packages \
    -e ".[sglang]" 2>/dev/null || \
    pip3 install --no-cache-dir --break-system-packages -e ".[core]" || \
    pip3 install --no-cache-dir --break-system-packages -e . || true

# Install SGLang for aarch64
RUN pip3 install --no-cache-dir --break-system-packages \
    torch --index-url https://download.pytorch.org/whl/cu128 || true
RUN pip3 install --no-cache-dir --break-system-packages \
    "sglang[all]" 2>/dev/null || true

# --- NIXL (from pre-built image or build inline) ---
FROM nixl:arm64 AS nixl

# --- Runtime ---
FROM nvcr.io/nvidia/cuda:12.8.0-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y \
    libhwloc15 libudev1 libzmq5 libprotobuf32t64 \
    libibverbs1 librdmacm1 libnuma1 \
    python3 python3-pip \
    numactl \
    && rm -rf /var/lib/apt/lists/*

# NIXL + UCX
COPY --from=nixl /opt/nixl /opt/nixl
COPY --from=nixl /opt/ucx /opt/ucx

# Dynamo binaries
COPY --from=builder /opt/dynamo/target/release/dynamo-* /opt/dynamo/bin/

# Python packages
COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=builder /usr/lib/python3/dist-packages /usr/lib/python3/dist-packages

ENV PATH="/opt/dynamo/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/nixl/lib:/opt/ucx/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"
ENV PYTHONPATH="/opt/nixl/lib/python3/dist-packages:${PYTHONPATH}"

# BF-3 SH defaults
ENV CUDA_VISIBLE_DEVICES=0
ENV UCX_NET_DEVICES=mlx5_0:1
ENV UCX_TLS=rc_mlx5,cuda_copy

# GPU is on BF-3 PCIe root complex
# Worker + control plane run from same image
EXPOSE 8000 8001 8002 9400

ENTRYPOINT ["/bin/bash"]
