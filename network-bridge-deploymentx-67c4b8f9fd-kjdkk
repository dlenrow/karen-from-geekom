apiVersion: apps/v1
kind: Deployment
metadata:
  name: net-bridge-test-deployment
  labels:
    app: net-bridge-test
spec:
  replicas: 1
  selector:
    matchLabels:
      app: net-bridge-test
  template:
    metadata:
      labels:
        app: net-bridge-test
    spec:
      containers:
        - name: bridge-container
          image: ubuntu
          command: ["/bin/bash", "-c"]
          args:
            - |
              # Install necessary packages
              apt-get update && apt-get install -y iproute2 bridge-utils iputils-ping netcat tcpdump

              # Enable IP forwarding
              echo 1 > /proc/sys/net/ipv4/ip_forward

              # Create a bridge interface and veth pairs
              ip link add br0 type bridge
              ip link add veth1 type veth peer name veth2

              # Bring up bridge and veth interfaces
              ip link set br0 up
              ip link set veth1 up
              ip link set veth2 up

              # Add veth1 to the bridge
              ip link set veth1 master br0

              # Assign IPs to the bridge and veth2 interface
              ip addr add 192.168.1.1/24 dev br0
              ip addr add 192.168.1.2/24 dev veth2

              # Keep the container running
              tail -f /dev/null
          securityContext:
            privileged: true
      hostNetwork: true
      restartPolicy: Always

